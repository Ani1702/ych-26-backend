generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  email        String   @id @unique
  name         String
  regNo        String   @unique
  gender       String
  school       String
  branch       String
  hostelBlock  String
  roomNo       String?
  mobileNo     String
  hasTeam      Boolean  @default(false)
  isTeamLeader Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Team {
  teamId             String   @id @unique
  teamName           String   @unique
  teamLeader         String
  teamMembers        String[]
  problemStatementId String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  round0Status       QualificationStatus @default(NOT_SUBMITTED)
  round1Status       QualificationStatus @default(NOT_SUBMITTED)
  round2Status       QualificationStatus @default(NOT_SUBMITTED)
  round3Status       QualificationStatus @default(NOT_SUBMITTED)
}

model Submission {
  id               String   @id @default(uuid())
  teamId           String
  teamName         String
  round0Submission Json?
  round1Submission Json?
  round2Submission Json?
  round3Submission Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Round {
  roundId   Int         @id
  status    RoundStatus @default(LOCKED)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}

enum RoundStatus {
  LOCKED
  LIVE
  COMPLETED
}

enum QualificationStatus {
  NOT_SUBMITTED
  SUBMITTED
  QUALIFIED
  NOT_QUALIFIED
}
